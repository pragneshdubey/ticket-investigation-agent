# ==============================================================================
# Resolve AI Environment Configuration Example
# Copy this file to '.env' or 'backend/.env'
# ==============================================================================

# Local Ollama Configuration (Default setup - $0 API cost, no API keys required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# FastAPI Backend & Host Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Development Server Configuration
FRONTEND_PORT=8443

# Optional: External Cloud API Key (Only required if using Cloud LLM fallbacks; NOT needed for default local Ollama setup)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.7-flash

