# ==============================================================================
# Resolve AI Configuration Reference (.env.example)
# OPTIONAL: The application runs 100% locally out-of-the-box without a .env file!
# This template is provided only as a reference for users wishing to customize local URLs/ports.
# ==============================================================================

# Local Ollama Inference Configuration ($0 API Cost - Default Setup)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Server & Host Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8443
